---
---

<div
  id="topic-drawer-backdrop"
  class="fixed inset-0 z-50 hidden bg-forest-deep/75 backdrop-blur-sm transition-opacity duration-200"
  aria-hidden="true"
>
  <div class="fixed inset-y-0 right-0 max-w-full flex pl-0 sm:pl-10">
    <div
      id="topic-drawer"
      role="dialog"
      aria-modal="true"
      aria-labelledby="topic-modal-title"
      class="w-screen max-w-xl h-full max-h-dvh bg-bg-surface text-text-main border-l border-border-subtle shadow-2xl flex flex-col overflow-hidden"
    >
      <div class="px-6 py-4 border-b border-border-subtle flex items-center justify-between gap-3 shrink-0 bg-bg-surface z-10">
        <div class="flex items-center gap-2 min-w-0 flex-wrap">
          <span id="topic-stage-badge" class="text-xs px-2.5 py-1 rounded-full font-mono font-semibold bg-sage/15 text-forest dark:text-mint border border-sage/30 truncate max-w-[260px] sm:max-w-xs">
            Stage 1
          </span>
          <span id="topic-importance-badge" class="text-xs px-2.5 py-1 rounded-full font-mono font-semibold bg-bg-surface-hover text-text-muted border border-border-subtle shrink-0">
            Essential
          </span>
        </div>
        <button
          id="topic-close-btn"
          type="button"
          class="p-2 rounded-xl text-text-muted hover:text-text-main hover:bg-bg-surface-hover border border-transparent hover:border-border-subtle transition-colors shrink-0"
          aria-label="Close topic panel"
        >
          <svg aria-hidden="true" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div id="topic-drawer-body" class="p-6 space-y-6 flex-1 overflow-y-auto overscroll-contain bg-bg-surface">
        <div>
          <div class="flex items-center gap-2 text-xs text-text-faint font-mono font-medium mb-1.5">
            <span id="topic-time-estimate">12 hours estimated</span>
          </div>
          <h2 id="topic-modal-title" class="text-2xl font-extrabold text-text-main leading-tight"></h2>
        </div>

        <div class="space-y-2">
          <h3 class="text-xs font-mono uppercase tracking-wider text-text-faint font-bold">
            Overview
          </h3>
          <p id="topic-description" class="text-sm text-text-muted leading-relaxed"></p>
        </div>

        <div class="p-4 rounded-xl bg-sage/12 dark:bg-sage/15 border border-sage/35 space-y-1.5">
          <div class="flex items-center gap-2 text-forest dark:text-mint text-xs font-bold font-mono uppercase">
            <svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Why It Matters in Production
          </div>
          <p id="topic-why-it-matters" class="text-xs sm:text-sm text-text-main leading-relaxed"></p>
        </div>

        <div id="topic-takeaways-container" class="space-y-2.5">
          <h3 class="text-xs font-mono uppercase tracking-wider text-text-faint font-bold">
            Core Takeaways
          </h3>
          <ul id="topic-takeaways-list" class="space-y-2 text-xs sm:text-sm text-text-muted list-disc pl-5 leading-relaxed"></ul>
        </div>

        <div class="space-y-3">
          <h3 class="text-xs font-mono uppercase tracking-wider text-text-faint font-bold">
            Curated Resources (Free & Verified)
          </h3>
          <div id="topic-resources-list" class="space-y-2.5"></div>
        </div>

        <div id="topic-interview-container" class="p-4 rounded-xl bg-slate-sage/12 dark:bg-slate-sage/15 border border-slate-sage/35 space-y-1.5">
          <div class="flex items-center gap-1.5 text-forest dark:text-mint text-xs font-bold font-mono uppercase">
            <span aria-hidden="true">💡</span> Interview Insight
          </div>
          <p id="topic-interview-tip" class="text-xs sm:text-sm text-text-main leading-relaxed"></p>
        </div>
      </div>

      <div class="px-6 py-4 border-t border-border-subtle bg-bg-surface shrink-0 z-10 flex items-center justify-between gap-4 shadow-[0_-4px_16px_rgba(0,0,0,0.06)]">
        <button
          id="topic-toggle-completed-btn"
          type="button"
          class="flex-1 py-3 px-4 rounded-xl font-semibold text-sm flex items-center justify-center gap-2 transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2"
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span id="topic-toggle-btn-label">Mark as Done</span>
        </button>

        <div class="flex items-center gap-1.5 shrink-0">
          <button
            id="topic-prev-btn"
            type="button"
            class="p-2.5 rounded-xl border border-border-strong bg-bg-surface text-text-main hover:bg-bg-surface-hover disabled:opacity-35 disabled:cursor-not-allowed transition-colors"
            title="Previous topic"
            aria-label="Previous topic"
          >
            <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            id="topic-next-btn"
            type="button"
            class="p-2.5 rounded-xl border border-border-strong bg-bg-surface text-text-main hover:bg-bg-surface-hover disabled:opacity-35 disabled:cursor-not-allowed transition-colors"
            title="Next topic"
            aria-label="Next topic"
          >
            <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
